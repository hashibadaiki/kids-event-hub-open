{
  "name": "kids-event-hub-open",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.9",
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "test": "pnpm -r --if-present test && pnpm test:claude",
    "test:claude": "node --test .claude/hooks/*.test.mjs",
    "sync-sources": "pnpm --filter @kids-event-hub/crawler sync-sources",
    "check-policy": "pnpm --filter @kids-event-hub/crawler check-policy",
    "improve-prod": "pnpm --filter @kids-event-hub/crawler improve-prod"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.0.0"
  }
}
