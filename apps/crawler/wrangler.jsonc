// クローラーの Worker。Cron Trigger でクロールする（デプロイはオーナーが実行）
{
  "name": "kids-event-hub-crawler",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-01",
  // 03:00 JST（UTC 18:00）に全収集元、12:00 JST（UTC 03:00）は直前に失敗した収集元の取り直し。
  // どちらも crawlAll が対象を選ぶ: 最後に成功した取得から 20 時間、直前の取得から 6 時間たっていない収集元はスキップする
  "triggers": { "crons": ["0 18 * * *", "0 3 * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kids-event-hub",
      "database_id": "df666d2a-5dd8-4fdd-ae32-0910664efe80",
      "migrations_dir": "../../packages/db/migrations"
    }
  ]
}
